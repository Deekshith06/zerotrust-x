# Local demo configuration only. Do not place production credentials here.
ZEROTRUST_INPUT_DIR=track2_cybersecurity_dataset_files
ZEROTRUST_PROCESSED_DIR=data/processed
ZEROTRUST_QUARANTINE_DIR=data/quarantine
ZEROTRUST_HOST=127.0.0.1
ZEROTRUST_PORT=8000
ZEROTRUST_ENV=demo
ZEROTRUST_CORS_ORIGINS=
ZEROTRUST_AUDIT_PATH=data/audit.jsonl
MAX_QUERY_LIMIT=1000
RATE_LIMIT_PER_MINUTE=120
# Required for staging/production; demo tokens are rejected by the deployment contract.
# OIDC_ISSUER=https://idp.example.com/realms/zerotrust-x
# OIDC_AUDIENCE=zerotrust-x-api
